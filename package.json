{
  "name": "nexora-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "seed": "npm run seed --workspace=server",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:server": "npm run build --workspace=server",
    "start:server": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=web",
    "lint:web": "npm run lint --workspace=web"
  }
}
